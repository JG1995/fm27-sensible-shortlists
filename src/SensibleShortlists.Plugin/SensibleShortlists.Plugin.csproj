<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SensibleShortlists</AssemblyName>
    <RootNamespace>SensibleShortlists.Plugin</RootNamespace>
    <Product>FM27 Sensible Shortlists</Product>
    <BepInExPluginGuid>fm27.sensibleshortlists</BepInExPluginGuid>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: the game's BepInEx install provides these at run time. -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="[6.0.0-be.785]" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="[2.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SensibleShortlists.Core/SensibleShortlists.Core.csproj" />
  </ItemGroup>

  <!-- Game assemblies generated by Il2CppInterop. See GameInteropDir in Directory.Build.props. -->
  <ItemGroup>
    <Reference Include="FM.GamePlugin;FM.UI;SI.Bindable;SI.Bindable.Reference.Core;SI.Core;SI.Interop;Il2Cppmscorlib">
      <HintPath>$(GameInteropDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireGameInterop" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="!Exists('$(GameInteropDir)/FM.GamePlugin.dll')"
      Text="Game interop assemblies not found in '$(GameInteropDir)'. Install BepInEx 6 IL2CPP into FM27, run the game once, and set FM27_GAME_DIR if the game is not in the default Steam location." />
  </Target>

</Project>
