# Project wiki: maintained locally by the user and agents, intentionally not tracked.
# No trailing slash: in a worktree `.wiki` is a link, which a directory-only pattern does not match.
.wiki

# Brand-identity skill work folder (sets, boards, kits); the chosen identity is carried into .wiki/DESIGN.md
/brand-identity/

# Worktrees that Claude Code creates for parallel sessions
.claude/worktrees/

# .NET build output
bin/
obj/

# Machine-specific build settings, such as the game install location
Directory.Build.user.props
